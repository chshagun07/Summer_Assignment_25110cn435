//Program to print character triangle
A
AB
ABC
ABCD
ABCDE
#include <stdio.h>
int main() {

    for ( int i = 1; i <= 5; i++) {
        for ( int j = 0; j < i; j++) {
            printf("%c", 'A' + j);
        }
        printf("\n");
    }

    return 0;
}


