//Program to calculate sum of first  N Natural numbers
  #include <stdio.h>
  int main()
{
  int n,i, sum=0;
  printf("ENTER A POSITIVE NUMBER:");
  scanf("%d" , &n);
  for(i = 1; i <= n; ++i)
  {
    sum += i;
  }
  printf("SUM OF FIRST N NATURAL NUMBERS: %d\n", n , sum);
  return 0;
}


